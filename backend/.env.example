PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Neon PostgreSQL Database
# DATABASE_URL: Pooler connection string for high concurrency query traffic
# DIRECT_URL: Direct compute instance connection string for Prisma DDL migrations
DATABASE_URL="postgresql://user:password@ep-sample-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="your-super-secret-jwt-key"

# WhatsApp Concierge Hotline
ARGYR_WHATSAPP_NUMBER="2348000000000"

# Cloudinary Assets Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Flutterwave Payment Gateway
FLW_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X"
FLW_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X"
FLW_ENCRYPTION_KEY="FLWSECK_TESTxxxxxx"
FLW_WEBHOOK_SECRET_HASH="argyr_flw_secret_hash_2026"

# Transactional Email Dispatch (SMTP / Resend / Sendgrid)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS="re_xxxxxxxxxxxxxxxx"
SMTP_FROM="ARGYR Footwear <orders@argyrworldwide.com>"
SMTP_SECURE=false
