datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
  DRAFT
}

enum Gender {
  MEN
  WOMEN
  KIDS
  UNISEX
}

enum OrderStatus {
  NEW
  CONTACTED
  NEGOTIATING
  COMPLETED
  CANCELLED
}

enum CustomRequestStatus {
  NEW
  REVIEWING
  ACCEPTED
  REJECTED
  COMPLETED
}

model AdminUser {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         AdminRole   @default(SUPER_ADMIN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lastLoginAt  DateTime?
  active       Boolean     @default(true)
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                  String         @id @default(uuid())
  name                String
  slug                String         @unique
  description         String
  shortDescription    String
  price               Decimal        @db.Decimal(12, 2)
  bulkPrice           Decimal?       @db.Decimal(12, 2)
  bulkMinimumQuantity Int            @default(10)
  stockQuantity       Int            @default(0)
  sku                 String         @unique
  category            Category       @relation(fields: [categoryId], references: [id])
  categoryId          String
  gender              Gender         @default(UNISEX)
  material            String
  collection          String?
  featured            Boolean        @default(false)
  newArrival          Boolean        @default(false)
  bestSeller          Boolean        @default(false)
  status              ProductStatus  @default(DRAFT)
  sizes               String[]       // e.g. ["38", "39", "40", "41", "42", "43", "44"]
  images              ProductImage[]
  customReferences    CustomRequest[] @relation("ProductReference")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model ProductImage {
  id         String   @id @default(uuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  publicId   String?  // Cloudinary identifier
  createdAt  DateTime @default(now())
}

model Order {
  id               String      @id @default(uuid())
  orderReference   String      @unique // e.g., ARGYR-123456
  customerName     String
  customerPhone    String
  customerEmail    String?
  deliveryCountry  String
  deliveryCity     String
  deliveryAddress  String
  notes            String?
  currency         String      @default("NGN")
  subtotal         Decimal     @db.Decimal(12, 2)
  estimatedTotal   Decimal     @db.Decimal(12, 2)
  status           OrderStatus @default(NEW)
  whatsappMessage  String      @db.Text
  whatsappOpenedAt DateTime?
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id                String  @id @default(uuid())
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  productId         String? // Nullable in case product is deleted, snapshot keeps details
  productName       String  // Snapshot name
  productSku        String  // Snapshot SKU
  selectedSize      String
  selectedColour    String?
  quantity          Int
  unitPrice         Decimal @db.Decimal(12, 2)
  estimatedSubtotal Decimal @db.Decimal(12, 2)
}

model CustomRequest {
  id               String              @id @default(uuid())
  requestReference String              @unique // e.g., ARGYR-CUSTOM-123456
  customerName     String
  customerPhone    String
  customerEmail    String?
  referenceProduct Product?            @relation("ProductReference", fields: [productId], references: [id])
  productId        String?
  categoryName     String              // Text description of shoe type (Sneaker, Oxford, etc.)
  gender           Gender              @default(UNISEX)
  shoeSize         String
  preferredColour  String
  preferredMaterial String
  quantity         Int                 @default(1)
  description      String              @db.Text
  additionalNotes  String?             @db.Text
  images           CustomRequestImage[]
  country          String
  city             String
  deliveryAddress  String?
  status           CustomRequestStatus @default(NEW)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model CustomRequestImage {
  id              String        @id @default(uuid())
  customRequest   CustomRequest @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
  customRequestId String
  url             String
  publicId        String?
  createdAt       DateTime      @default(now())
}

model Setting {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
