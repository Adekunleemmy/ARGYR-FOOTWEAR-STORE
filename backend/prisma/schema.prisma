datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
  DRAFT
}

enum Gender {
  MEN
  WOMEN
  KIDS
  UNISEX
}

enum OrderStatus {
  NEW
  CONTACTED
  NEGOTIATING
  COMPLETED
  CANCELLED
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  CONFIRMED
  IN_PRODUCTION
  READY_FOR_SHIPPING
  SHIPPED
  DELIVERED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
}

enum CustomRequestStatus {
  NEW
  REVIEWING
  ACCEPTED
  REJECTED
  COMPLETED
}

model AdminUser {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         AdminRole   @default(SUPER_ADMIN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lastLoginAt  DateTime?
  active       Boolean     @default(true)
}

model Customer {
  id              String               @id @default(uuid())
  firstName       String
  lastName        String
  email           String               @unique
  passwordHash    String
  phone           String?
  isEmailVerified Boolean              @default(false)
  marketingOptIn  Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  lastLoginAt     DateTime?
  otps            CustomerOtp[]
  orders          Order[]
  addresses       CustomerAddress[]
  passwordResets  PasswordResetToken[]
}

model CustomerOtp {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  code       String    // 6-digit OTP code
  purpose    String    @default("EMAIL_VERIFICATION") // EMAIL_VERIFICATION, PASSWORD_RESET
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, purpose])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label         String?  // Home, Office, etc.
  recipientName String
  phone         String
  country       String
  stateRegion   String?
  city          String
  addressLine   String
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
}

model ShippingMethod {
  id          String   @id @default(uuid())
  name        String   // "Lagos Island", "Lagos Mainland", "Nigeria — Outside Lagos", "International"
  code        String   @unique
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("NGN")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                  String         @id @default(uuid())
  name                String
  slug                String         @unique
  description         String
  shortDescription    String
  price               Decimal        @db.Decimal(12, 2)
  bulkPrice           Decimal?       @db.Decimal(12, 2)
  bulkMinimumQuantity Int            @default(10)
  stockQuantity       Int            @default(0)
  sku                 String         @unique
  category            Category       @relation(fields: [categoryId], references: [id])
  categoryId          String
  gender              Gender         @default(UNISEX)
  material            String
  collection          String?
  featured            Boolean        @default(false)
  newArrival          Boolean        @default(false)
  bestSeller          Boolean        @default(false)
  status              ProductStatus  @default(DRAFT)
  sizes               String[]       // e.g. ["38", "39", "40", "41", "42", "43", "44"]
  images              ProductImage[]
  customReferences    CustomRequest[] @relation("ProductReference")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model ProductImage {
  id         String   @id @default(uuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  publicId   String?  // Cloudinary identifier
  createdAt  DateTime @default(now())
}

model Order {
  id                         String               @id @default(uuid())
  orderReference             String               @unique // e.g., ARGYR-123456
  customerName               String
  customerPhone              String
  customerEmail              String?
  customerId                 String?
  customer                   Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryCountry            String
  deliveryCity               String
  deliveryAddress            String
  deliveryState              String?
  deliveryPostalCode         String?
  deliveryInstructions       String?
  notes                      String?
  currency                   String               @default("NGN")
  subtotal                   Decimal              @db.Decimal(12, 2)
  estimatedTotal             Decimal              @db.Decimal(12, 2)
  shippingMethodName         String?              // Snapshot of method name e.g. "Lagos Island"
  shippingCost               Decimal              @default(0) @db.Decimal(12, 2) // Snapshot of shipping fee
  totalAmount                Decimal              @default(0) @db.Decimal(12, 2) // Final authoritative total: subtotal + shipping
  estimatedDeliveryTimeframe String?              // Snapshot e.g. "7–14 days"
  isPaid                     Boolean              @default(false)
  paidAt                     DateTime?
  status                     OrderStatus          @default(NEW)
  whatsappMessage            String               @db.Text
  whatsappOpenedAt           DateTime?
  items                      OrderItem[]
  payments                   Payment[]
  statusHistory              OrderStatusHistory[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id                String  @id @default(uuid())
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  productId         String? // Nullable in case product is deleted, snapshot keeps details
  productName       String  // Snapshot name
  productSku        String  // Snapshot SKU
  productImage      String? // Snapshot image URL
  selectedSize      String
  selectedColour    String?
  quantity          Int
  unitPrice         Decimal @db.Decimal(12, 2)
  estimatedSubtotal Decimal @db.Decimal(12, 2)
  subtotal          Decimal? @db.Decimal(12, 2)
}

model Payment {
  id                   String        @id @default(uuid())
  orderId              String
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionReference String        @unique // e.g. ARGYR-TX-123456
  flwTransactionId     String?       // Flutterwave transaction ID
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("NGN")
  status               PaymentStatus @default(PENDING)
  paymentMethod        String?       // card, banktransfer, etc.
  gatewayResponse      String?       @db.Text // Full response / note
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

model OrderStatusHistory {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus OrderStatus?
  newStatus      OrderStatus
  internalNote   String?      @db.Text
  customerNote   String?      @db.Text
  changedBy      String?      // Admin user ID, or SYSTEM, or FLUTTERWAVE
  createdAt      DateTime     @default(now())

  @@index([orderId])
}

model AdminNotificationEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomRequest {
  id               String              @id @default(uuid())
  requestReference String              @unique // e.g., ARGYR-CUSTOM-123456
  customerName     String
  customerPhone    String
  customerEmail    String?
  referenceProduct Product?            @relation("ProductReference", fields: [productId], references: [id])
  productId        String?
  categoryName     String              // Text description of shoe type (Sneaker, Oxford, etc.)
  gender           Gender              @default(UNISEX)
  shoeSize         String
  preferredColour  String
  preferredMaterial String
  quantity         Int                 @default(1)
  description      String              @db.Text
  additionalNotes  String?             @db.Text
  images           CustomRequestImage[]
  country          String
  city             String
  deliveryAddress  String?
  status           CustomRequestStatus @default(NEW)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model CustomRequestImage {
  id              String        @id @default(uuid())
  customRequest   CustomRequest @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
  customRequestId String
  url             String
  publicId        String?
  createdAt       DateTime      @default(now())
}

model Setting {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
